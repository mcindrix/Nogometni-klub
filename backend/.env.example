DATABASE_URL=mysql+pymysql://nk_app:<lozinka>@127.0.0.1:3306/nogometni_klub
AUTH_SECRET_KEY=<generiraj s: openssl rand -hex 32>

# koristi ih docker-compose.yml da postavi MySQL kontejner
# (moraju se slagati s korisnikom/lozinkom u DATABASE_URL iznad)
MYSQL_ROOT_PASSWORD=<odaberi-root-lozinku>
MYSQL_DATABASE=nogometni_klub
MYSQL_USER=nk_app
MYSQL_PASSWORD=<lozinka>
